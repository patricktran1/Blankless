# Blankless works with every variable below unset.

# Band agent API key. Server-side only. Enables timeline mirroring to Band.
BAND_API_KEY=
# Optional existing Band chat UUID. When omitted, Blankless creates a chat per workflow.
BAND_CHAT_ID=

# Actian VectorAI DB is local-development only and is automatically disabled on Vercel.
# Optional gRPC address used by @actian/vectorai-client (default when enabled: localhost:6574).
ACTIAN_GRPC_ADDR=
# Optional REST fallback URL used by @actian/vectorai-client (default when enabled: http://localhost:6573).
ACTIAN_REST_URL=
# Optional VectorAI DB access token.
ACTIAN_ACCESS_TOKEN=

# Guild API Trigger invocation URL. Server-side only.
GUILD_API_TRIGGER_URL=
# Full Guild HTTP Basic credential exactly as generated by the trigger (username:password).
GUILD_API_KEY=

# Public Replay QA run/report URL. When set, the footer displays a linked QA badge.
NEXT_PUBLIC_REPLAY_RUN_URL=